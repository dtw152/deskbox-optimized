<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.TimerWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DeskBox.Controls.WidgetContents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="计时器"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    IsTabStop="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:TimerBoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:TimerInverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="TimerPresetButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="{StaticResource WidgetCornerRadiusSmall}" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TimerPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="{StaticResource WidgetCornerRadiusSmall}" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TimerSecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="{StaticResource WidgetCornerRadiusSmall}" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TimerUnitBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="14,10,14,12" RowSpacing="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Mode + total duration -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                Width="108"
                FontSize="12"
                HorizontalAlignment="Left"
                AutomationProperties.Name="计时模式"
                SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="倒计时" />
                <ComboBoxItem Content="秒表" />
            </ComboBox>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding DurationText}" />
        </Grid>

        <!-- Readout -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.Name="剩余时间"
                FontSize="42"
                FontWeight="SemiBold"
                IsTextScaleFactorEnabled="False"
                Text="{Binding TimeText}"
                TextAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding StateText}"
                TextAlignment="Center" />
        </StackPanel>

        <ProgressBar
            Grid.Row="2"
            Height="4"
            VerticalAlignment="Center"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
            Maximum="1"
            Minimum="0"
            Visibility="{Binding IsCountdownMode, Converter={StaticResource BoolToVisibility}}"
            Value="{Binding ProgressValue, Mode=OneWay}" />

        <!-- Custom duration -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <NumberBox
                AutomationProperties.Name="小时"
                Maximum="24"
                Minimum="0"
                Style="{StaticResource TimerUnitBoxStyle}"
                Value="{Binding CustomHours, Mode=TwoWay}" />
            <TextBlock VerticalAlignment="Center" FontSize="11" Text="时" />
            <NumberBox
                AutomationProperties.Name="分钟"
                Maximum="59"
                Minimum="0"
                Style="{StaticResource TimerUnitBoxStyle}"
                Value="{Binding CustomMinutes, Mode=TwoWay}" />
            <TextBlock VerticalAlignment="Center" FontSize="11" Text="分" />
            <NumberBox
                AutomationProperties.Name="秒"
                Maximum="59"
                Minimum="0"
                Style="{StaticResource TimerUnitBoxStyle}"
                Value="{Binding CustomSeconds, Mode=TwoWay}" />
            <TextBlock VerticalAlignment="Center" FontSize="11" Text="秒" />
            <Button
                Height="28"
                Padding="10,0"
                AutomationProperties.Name="应用自定义时长"
                Click="ApplyDuration_Click"
                CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                Content="应用"
                FontSize="12" />
        </StackPanel>

        <!-- Presets -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            Spacing="5">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <Button Click="Preset_Click" Content="1 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="1" />
                <Button Click="Preset_Click" Content="3 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="3" />
                <Button Click="Preset_Click" Content="5 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="5" />
                <Button Click="Preset_Click" Content="10 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="10" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <Button Click="Preset_Click" Content="15 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="15" />
                <Button Click="Preset_Click" Content="25 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="25" />
                <Button Click="Preset_Click" Content="30 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="30" />
                <Button Click="Preset_Click" Content="60 分" Style="{StaticResource TimerPresetButtonStyle}" Tag="60" />
            </StackPanel>
        </StackPanel>

        <!-- Transport -->
        <StackPanel
            Grid.Row="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                AutomationProperties.Name="开始或暂停计时"
                Click="Primary_Click"
                Style="{StaticResource TimerPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="13" Glyph="{Binding PrimaryButtonGlyph}" />
                    <TextBlock FontSize="13" Text="{Binding PrimaryButtonText}" />
                </StackPanel>
            </Button>
            <Button
                AutomationProperties.Name="重置计时器"
                Click="Reset_Click"
                IsEnabled="{Binding CanReset, Mode=OneWay}"
                Style="{StaticResource TimerSecondaryButtonStyle}">
                <TextBlock FontSize="13" Text="重置" />
            </Button>
            <Button
                AutomationProperties.Name="计次"
                Click="Lap_Click"
                IsEnabled="{Binding CanRecordLap, Mode=OneWay}"
                Style="{StaticResource TimerSecondaryButtonStyle}"
                Visibility="{Binding IsStopwatchMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="13" Text="计次" />
            </Button>
        </StackPanel>

        <!-- Options -->
        <StackPanel
            Grid.Row="6"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="14">
            <CheckBox
                MinWidth="0"
                AutomationProperties.Name="结束提示音"
                Content="提示音"
                FontSize="12"
                IsChecked="{Binding SoundEnabled, Mode=TwoWay}" />
            <CheckBox
                MinWidth="0"
                AutomationProperties.Name="循环计时"
                Content="循环"
                FontSize="12"
                IsChecked="{Binding LoopEnabled, Mode=TwoWay}"
                Visibility="{Binding IsCountdownMode, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Laps -->
        <ListView
            Grid.Row="7"
            MaxHeight="66"
            FontSize="11"
            ItemsSource="{Binding Laps}"
            SelectionMode="None"
            Visibility="{Binding IsStopwatchMode, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
